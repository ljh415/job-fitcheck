GOOGLE_API_KEY=AIza...        # 기본 provider, 무료 티어로 바로 체험 가능
APP_SECRET=your-password-here
ANTHROPIC_API_KEY=sk-ant-...  # 선택 (추천 — 더 정확한 분석을 원하면 설정에서 Claude로 전환)
OPENAI_API_KEY=sk-...         # 선택
DEFAULT_PROVIDER=gemini

# 분석 완료 알림 (선택, 하나 이상 설정 시 자동 전송)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=

# RAG 서브프로젝트(rag/main 브랜치 전용) — 3050Ti 로컬 임베딩 추론 서버 SSH 접속 정보.
# main 브랜치엔 존재하지 않는 설정, LocalEmbeddingProvider 사용 시에만 필요.
RAG_LOCAL_SSH_HOST=
RAG_LOCAL_SSH_PORT=10222
RAG_LOCAL_SSH_USER=
RAG_LOCAL_SSH_KEY_PATH=
RAG_LOCAL_EMBED_PORT=8500
