GOOGLE_API_KEY=AIza...        # 기본 provider, 무료 티어로 바로 체험 가능
APP_SECRET=your-password-here
ANTHROPIC_API_KEY=sk-ant-...  # 선택 (추천 — 더 정확한 분석을 원하면 설정에서 Claude로 전환)
OPENAI_API_KEY=sk-...         # 선택
DEFAULT_PROVIDER=gemini

# 분석 완료 알림 (선택, 하나 이상 설정 시 자동 전송)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=

# RAG(Agentic RAG, 선택) — 채용공고 기반 대화형 분석 기능. 켜려면 RAG_POSTGRES_HOST를
# 설정하고 `docker compose --profile rag up`으로 실행해야 함(Postgres 컨테이너 별도 필요,
# uv 직접 실행 경로는 미지원). 임베딩은 GOOGLE_API_KEY를 그대로 재사용하므로 별도 키 불필요.
RAG_POSTGRES_HOST=
RAG_POSTGRES_PORT=5432
RAG_POSTGRES_DB=rag
RAG_POSTGRES_USER=rag
RAG_POSTGRES_PASSWORD=rag  # 로컬 전용 기본값. 외부 노출 환경이면 반드시 변경할 것
# 기본 false — 켜면 이력서(프로필) 내용이 현재 선택된 임베딩 provider(기본 Google)로 전송됨.
# 꺼져 있으면 스킬 갭 분석 등 프로필 근거 기반 기능 UI 자체가 숨겨지고, API를 직접 불러도
# 400으로 차단됨(공고 검색·시장수요 등 프로필과 무관한 기능은 영향 없음).
RAG_INCLUDE_PROFILE=false
