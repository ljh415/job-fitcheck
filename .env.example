GOOGLE_API_KEY=AIza...        # 기본 provider, 무료 티어로 바로 체험 가능
APP_SECRET=your-password-here
ANTHROPIC_API_KEY=sk-ant-...  # 선택 (추천 — 더 정확한 분석을 원하면 설정에서 Claude로 전환)
OPENAI_API_KEY=sk-...         # 선택
DEFAULT_PROVIDER=gemini

# 분석 완료 알림 (선택, 하나 이상 설정 시 자동 전송)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=

# RAG(Agentic RAG, 선택) — 채용공고 기반 대화형 분석 기능. 켜려면 RAG_POSTGRES_HOST를
# 설정하고 `docker compose --profile rag up`으로 실행해야 함(Postgres 컨테이너 별도 필요,
# uv 직접 실행 경로는 미지원). 임베딩은 GOOGLE_API_KEY를 그대로 재사용하므로 별도 키 불필요.
RAG_POSTGRES_HOST=
# 아래 4개는 기본값이 이미 config.py/docker-compose.yml에 박혀 있어 안 채워도 됩니다.
# 값을 바꾸고 싶을 때만 주석을 풀고 수정하세요(PASSWORD는 외부 노출 환경이면 꼭 변경할 것).
# RAG_POSTGRES_PORT=5432
# RAG_POSTGRES_DB=rag
# RAG_POSTGRES_USER=rag
# RAG_POSTGRES_PASSWORD=rag
# 기본 false — 켜면 이력서(프로필) 내용이 현재 선택된 임베딩 provider(기본 Google)로 전송됨.
# 꺼져 있으면 스킬 갭 분석 등 프로필 근거 기반 기능 UI 자체가 숨겨지고, API를 직접 불러도
# 400으로 차단됨(공고 검색·시장수요 등 프로필과 무관한 기능은 영향 없음).
RAG_INCLUDE_PROFILE=false

# RAG 로컬 임베딩 provider (선택) — 개인 GPU 서버가 있으면 Google 대신 그 서버로 임베딩을
# 계산할 수 있음. SSH로 접속 가능한 서버에서 임베딩 추론 서버(포트 RAG_LOCAL_EMBED_PORT)가
# 떠 있어야 하고, docker-compose.yml에 RAG_LOCAL_SSH_KEY_PATH를 컨테이너 안 같은 경로로
# 마운트하는 볼륨 설정을 직접 추가해야 함(기본 docker-compose.yml엔 없음 — 개인 키 경로라
# 사용자마다 달라서 예시로 남겨두지 않았음, 필요하면 docker-compose.yml의 api 서비스에
# `- /path/to/your/key:/path/to/your/key:ro` 형태로 추가). 설정 안 하면(빈 값) Google만 쓴다.
RAG_LOCAL_SSH_HOST=
RAG_LOCAL_SSH_PORT=22
RAG_LOCAL_SSH_USER=
RAG_LOCAL_SSH_KEY_PATH=
RAG_LOCAL_EMBED_PORT=8500
